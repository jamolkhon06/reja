<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>REJA</title>
    <link rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
      integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS"
      crossorigin="anonymous" />
    <style>
        body {
            background: linear-gradient(135deg, #eef2ff, #f8fafc);
            min-height: 100vh;
            color: #1f2937;
        }

        .container {
            max-width: 900px;
        }

        .display-4 {
            font-weight: 600;
            color: #111827;
            letter-spacing: -1px;
            margin-bottom: 30px;
        }

        .jumbotron {
            background: #ffffff;
            border: none;
            border-radius: 20px;
            margin-bottom: 30px;
        }

        #create-field {
            border: 1px solid #d1d5db;
            border-radius: 12px;
            padding: 12px 16px;
            height: 48px;
            transition: all 0.2s ease;
        }

        #create-field:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }

        #create-form .btn-primary {
            height: 48px;
            padding: 0 22px;
            border: none;
            border-radius: 12px !important;
            background: #6366f1;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.2s ease;
        }

        #create-form .btn-primary:hover {
            background: #4f46e5;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(79, 70, 229, 0.25);
        }

        #item-list {
            border-radius: 16px;
            overflow: hidden;
        }

        #item-list .list-group-item {
            background: #ffffff;
            border: none;
            border-bottom: 1px solid #eef0f4;
            padding: 18px 20px;
            min-height: 70px;
            transition: all 0.2s ease;
        }

        #item-list .list-group-item:last-child {
            border-bottom: none;
        }

        #item-list .list-group-item:hover {
            background: #f8faff;
            transform: translateX(2px);
        }

        .item-text {
            font-size: 16px;
            font-weight: 500;
            color: #374151;
        }

        .edit-me,
        .delete-me {
            border: none;
            border-radius: 9px;
            padding: 7px 13px;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .edit-me {
            background: #eef2ff;
            color: #4f46e5;
        }

        .edit-me:hover {
            background: #e0e7ff;
            color: #4338ca;
        }

        .delete-me {
            background: #fee2e2;
            color: #dc2626;
        }

        .delete-me:hover {
            background: #fecaca;
            color: #b91c1c;
        }

        #clean-all {
            margin-top: 20px;
            border: none;
            border-radius: 12px !important;
            padding: 11px 20px;
            background: #ef4444;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        #clean-all:hover {
            background: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(220, 38, 38, 0.2);
        }
    </style>
</head>
<body>

    <div class="container pt-4">
        <h1 class="display-4 text-center py-1">REJA VA MAQSADLAR</h1>
        <div class="jumbotron p-3 shadow-sm">
            <form id="create-form" action="/create-item" method="post">
                <div class="d-flex align-items-center">
                    <input
                        id="create-field"
                        name="reja"
                        autofocus
                        autocomplete="off"
                        class="form-control mr-3"
                        type="text"
                        style="flex: 1"
                        placeholder="Yangi rejangizni yozing..."
                    >
                    <button class="btn btn-primary">Yangi Reja Qo'shish</button>
                </div>
            </form>
        </div>
        <ul id="item-list" class="list-group pb-5">
            <% items.map(item => { %>
                <li class="list-group-item list-group-item-info d-flex align-items-center justify-content-between">
                    <span class="item-text"><%= item.reja%></span>
                    <div>
                        <button data-id="<%=item._id%>" class="edit-me btn btn-secondary btn-sm mr-1">O'zgartirish</button>
                        <button data-id="<%=item._id%>" class="delete-me btn btn-danger btn-sm">O'chirish</button>
                    </div>
                </li>
            <% }) %>
        </ul>
        <button id="clean-all" class="btn btn-danger">Hamma Rejalarni O'chirish</button>
    </div>

    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <script src="/browser.js"></script>

</body>
</html>
